# Copy to .env.local and fill in real values. Never commit .env.local.

# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=

# WhatsApp Business number in international format, digits only, no + or spaces
WHATSAPP_BUSINESS_NUMBER=919028787219

# Public site URL, used for SEO metadata, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=https://aaicha pharal.example.com

# Admin authentication secret (generate with: openssl rand -base64 32)
ADMIN_AUTH_SECRET=

# Admin login credentials seed (first run only — change after first login)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
